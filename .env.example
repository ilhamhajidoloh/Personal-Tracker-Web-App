# ==========================================
# MyLife Web App - Environment Variables
# ==========================================

# Backend API
NUXT_PUBLIC_API_BASE=http://localhost:5147
NUXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Auth Secret (same as backend)
NUXT_JWT_KEY=your-backend-jwt-secret-key-at-least-32-chars
NUXT_JWT_ISSUER=back_mylife
NUXT_JWT_AUDIENCE=mylife-client

# Cron Secret (for /api/cron/check-reminders)
NUXT_CRON_SECRET=your-secret-cron-token

# ==========================================
# Gmail SMTP Settings (App Passwords)
# ==========================================
# Host: smtp.gmail.com (Default)
NUXT_SMTP_HOST=smtp.gmail.com
# Port: 465 (SSL) or 587 (TLS)
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
# Your Gmail Address
NUXT_SMTP_USER=your_email@gmail.com
# Gmail 16-character App Password
NUXT_SMTP_PASS=xxxx xxxx xxxx xxxx
# From Sender Name and Email
NUXT_SMTP_FROM="MyLife App" <your_email@gmail.com>

# ==========================================
# LINE Messaging API (Optional)
# ==========================================
NUXT_LINE_CHANNEL_ACCESS_TOKEN=
NUXT_LINE_CHANNEL_SECRET=
NUXT_PUBLIC_LINE_BOT_ADD_FRIEND_URL=
NUXT_PUBLIC_LINE_BOT_DISPLAY_NAME="MyLife Bot"

# ==========================================
# Google Calendar & Auth (Optional)
# ==========================================
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
